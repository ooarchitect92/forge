# Compose-only local defaults. Do not commit live provider credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_SITE_PROVIDER=openai
# Optional: when blank, each provider uses its own default model.
AI_MODEL_PLANNER=
AI_MODEL_GEMINI=gemini-3.5-flash-lite
# Backend-only base64 encoding of 32 random bytes. Keep stable across restarts.
# Required for retained prompts/retry; never use a provider API key here.
AI_PROMPT_ENCRYPTION_KEY=
AI_PROMPT_RETENTION_HOURS=24
# Worker: startup sweep then bounded, non-overlapping sweeps (1000–3600000 ms).
AI_PROMPT_CLEANUP_INTERVAL_MS=60000
# Optional Stitch + Claude workflow (server-only; never VITE_ variables).
STITCH_API_KEY=
AI_CLAUDE_DESIGN_MODEL=
AI_STITCH_MODEL=GEMINI_3_1_PRO
AI_DESIGN_MAX_PAGES=8
# Conservative internal reserved-call quota. It is not a dollar guarantee and
# does not replace Google, Anthropic or Figma account quotas/billing.
AI_DESIGN_DAILY_UNITS=100
AI_ARTIFACT_DIRECTORY=.data/ai-artifacts

# Figma imports should use a website-scoped `figma` connector whose secretRef
# resolves through the configured secret provider. This variable is a local
# development fallback only and is deliberately ignored in production.
FIGMA_ACCESS_TOKEN=
FIGMA_API_TIMEOUT_MS=20000
